# Default: normalise text files to LF in the repo (applies only to files touched from now on).
* text=auto eol=lf

# NEVER normalise applied migrations: changing bytes changes the checksum stored in _prisma_migrations.
server/prisma/migrations/** -text

# پایان‌خط LF برای اسکریپت‌های Bash مرحله‌ی recovery (در ویندوز با autocrlf، CRLF باعث خطای bash می‌شود).
# عمداً برای فایل‌های migration قاعده‌ای نوشته نشده: تغییر پایان‌خط آن‌ها checksum ثبت‌شده در _prisma_migrations را عوض می‌کند.
server/prisma/recovery/*.sh text eol=lf

# Preserve the exact bytes of the historical test fixture; never deployed as a migration.
server/prisma/recovery/historical-191557.sql -text
