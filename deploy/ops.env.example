# /etc/online-exam/ops.env; root-owned, 0600. Do not commit real values.
COMPOSE_ENV_FILE=/etc/online-exam/compose.env
OPS_STATE_DIR=/var/lib/online-exam
HEALTH_URL=https://exam.your-domain.ir/api/health
# HTTPS webhook accepting {"text":"..."}; use a dedicated operations receiver.
ALERT_WEBHOOK_URL=
# Only the PUBLIC age recipient is on the server. Keep private key offline.
AGE_RECIPIENT=
BACKUP_S3_URI=s3://separate-backup-bucket/database
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
# For S3-compatible providers; use current AWS CLI v2 with AWS_ENDPOINT_URL support.
AWS_ENDPOINT_URL=
